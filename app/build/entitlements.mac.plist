<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- processo principal: o V8 do Electron também aloca código com MAP_JIT. Mesma lista mínima
       dos helpers (entitlements.mac.inherit.plist, que explica o que ficou de fora e por quê). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- A entitlement restrita de navegador (com.apple.developer.web-browser.public-key-credential)
       NÃO entra aqui: sem o perfil de provisionamento embutido o macOS mata o app na abertura.
       Ela só entra depois da aprovação da Apple, junto com o perfil (veja docs/senhas-decisao.md). -->
</dict>
</plist>
